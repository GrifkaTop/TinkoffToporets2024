<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/jokeListFragment">

    <fragment
        android:id="@+id/jokeListFragment"
        android:name="com.example.toporetstinkoff24.JokeListFragment"
        android:label="Joke List">
        <action
            android:id="@+id/action_jokeListFragment_to_jokeDetailFragment"
            app:destination="@id/jokeDetailFragment"/>
        <action
            android:id="@+id/action_jokeListFragment_to_addJokeFragment"
            app:destination="@id/addJokeFragment"/>
    </fragment>

    <fragment
        android:id="@+id/jokeDetailFragment"
        android:name="com.example.toporetstinkoff24.JokeDetailFragment"
        android:label="Joke Detail"/>

    <fragment
        android:id="@+id/addJokeFragment"
        android:name="com.example.toporetstinkoff24.AddJokeFragment"
        android:label="Add Joke"/>
</navigation>
